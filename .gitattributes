# One line ending in the repository. Windows tools all read LF; the mix was accidental.
* text=auto eol=lf

# the Filament patch is applied byte for byte to an LF checkout: no line-ending conversion
*.patch -text

# The bundled test model is a binary Git blob (no LFS required).
assets/test-static.glb binary

# Preserve downloaded GLB/HDR bytes exactly.
assets/**/*.glb binary
assets/**/*.hdr binary

# Keep upstream license text formatting, including its original trailing spaces.
assets/cases/LICENSES/*.txt -whitespace
assets/environments/LICENSE.txt -whitespace
assets/realistic-scenes/gothic-cloister-corner/license.txt -whitespace
