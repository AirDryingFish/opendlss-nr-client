#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D frame;
layout(binding = 1, std430) buffer Pixels { uint rgba[]; };
layout(push_constant) uniform Copy { uint download; };
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(frame);
    if (any(greaterThanEqual(p, size))) return;
    int i = p.y * size.x + p.x;
    if (download != 0) rgba[i] = packUnorm4x8(imageLoad(frame, p));
    else imageStore(frame, p, unpackUnorm4x8(rgba[i]));
}
